{
  "name": "tafelrunde",
  "version": "1.0.0",
  "private": true,
  "description": "Rezepte, Wochenplanung und geteilte Einkaufslisten – Ende-zu-Ende verschlüsselt, ohne Server.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/katalog.mjs fetch && vite",
    "build": "node tools/katalog.mjs fetch && vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "licenses:check": "node tools/check-licenses.mjs",
    "spike": "vite --config spikes/drive-sync/vite.config.ts",
    "spike:build": "vite build --config spikes/drive-sync/vite.config.ts",
    "katalog": "node tools/katalog.mjs fetch",
    "katalog:update": "node tools/katalog.mjs update"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tafelritter/rezeptformat": "github:Tafelritter/rezeptformat#v1.0.0",
    "minisearch": "7.2.0",
    "uqr": "0.1.3",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "y-codemirror.next": "0.3.6",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "6.2.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "workbox-window": "^7.4.1"
  }
}
